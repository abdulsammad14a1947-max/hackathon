# HCM Lite — environment template. Copy to `.env` and fill in. NEVER commit real values.

# --- Backend core ---
APP_ENV=development
LOG_LEVEL=info
API_PORT=8000
# SQLite (default dev) or PostgreSQL (production)
DATABASE_URL=sqlite:///./hcm_lite.db
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/hcm_lite
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRY_MINUTES=720

# --- Optional bootstrap admin (used only when no company exists yet) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI provider (backend only; optional — offline fallback works without it) ---
AI_PROVIDER=openai            # openai | offline
AI_API_KEY=                   # leave empty to run in labeled offline mode
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15
AI_RATE_LIMIT_PER_HOUR=20
AI_MOCK_MODE=false            # true forces the offline provider

# --- Face attendance (camera check-in) ---
# Download the sha256-pinned OpenCV model zoo files once:
#   cd backend && python -m app.face.models
FACE_MODEL_DIR=               # default: <backend>/face_models
FACE_MATCH_THRESHOLD=0.40     # cosine similarity required to accept a match
FACE_DETECTOR_SCORE=0.7       # YuNet minimum detection confidence
FACE_MIN_FACE_PX=80           # smallest acceptable face width/height (quality gate)
FACE_CHALLENGE_TTL_SECONDS=120  # single-use anti-replay challenge lifetime
FACE_MAX_IMAGE_MB=6           # hard cap per uploaded camera frame
FACE_RETENTION_DAYS=30        # prune expired challenge rows older than this

# --- Frontend (set before `npm run build`) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
